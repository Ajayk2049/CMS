{
  "name": "cms-backend",
  "version": "1.0.0",
  "description": "CMS and Tabletop Ordering backend server",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js --env-file=config/.env.dev",
    "dev:local": "nodemon server.js --env-file=config/.env.local",
