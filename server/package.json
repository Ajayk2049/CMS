    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@grpc/grpc-js": "^1.10.8",
    "@grpc/proto-loader": "^0.7.13",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.8.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.2",
    "jsqr": "^1.4.0",
    "mongoose": "^8.4.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.2",
